#!name = QQ音乐去广告
#!desc = 去除QQ音乐开屏广告。纯规则方案，零脚本依赖，基于实际抓包分析：c6.y.qq.com 的 fcg_get_advert 为广告内容下发接口，szmg.qq.com 为腾讯广告联盟平台（offer_id/heartbeat）。不影响听歌、歌词、下载等核心功能。
#!icon = https://m4a1dada.github.io/Loon-Plugin-Collection/icons/QQMusic.png
#!author = Marvis
#!category = 去广告
#!tag = QQ音乐

[General]
bypass-tun = 
skip-proxy = 

[Rule]
# ── QQ音乐开屏广告：广告内容下发接口（抓包验证，仅拦截该广告路径，不误伤设备注册等其他接口）──
URL-REGEX,^https?://c6\.y\.qq\.com/tips/fcgi-bin/fcg_get_advert,REJECT
# ── QQ音乐广告联盟平台：素材下发 / 曝光上报 / 心跳 ──
DOMAIN-SUFFIX,szmg.qq.com,REJECT
# ── 腾讯广告 SDK 点击/转化上报 ──
DOMAIN-SUFFIX,sdkreport.e.qq.com,REJECT

[Rewrite]

[Mitm]
