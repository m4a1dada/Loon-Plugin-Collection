#!name = 肯德基去广告
#!desc = 去除肯德基App开屏广告及内部广告（基于实际抓包分析）。纯规则方案，零脚本依赖。
#!icon = https://raw.githubusercontent.com/m4a1dada/Loon-Plugin-Collection/main/icons/KFC_v2.png
#!author = m4a1dada
#!category = tool
#!tag = 去广告

[General]
bypass-tun = 
skip-proxy = 

[Rule]
# ── KFC 自有广告系统（抓包验证）──
# 开屏广告预加载 & 全量广告配置（res.kfc.com.cn 仅拦截 /CRM/kfcad/ 路径，保留 /ruleConfig/ 等非广告配置）
URL-REGEX,^https?://res\.kfc\.com\.cn/CRM/kfcad/,REJECT
# 动态广告 API 子域名
DOMAIN-SUFFIX,dynamicad.kfc.com.cn,REJECT
# 广告素材 CDN
DOMAIN-SUFFIX,sares.kfc.com.cn,REJECT
# 广告数据追踪
DOMAIN-SUFFIX,adttrackingprd.hwwt8.com,REJECT
DOMAIN-SUFFIX,trackingprd.hwwt8.com,REJECT
# AB 测试广告路由
DOMAIN-SUFFIX,abplatform.yumchina.com,REJECT
# 设备指纹（广告反作弊/追踪）
DOMAIN-SUFFIX,fp.hwwt8.com,REJECT

# ── 第三方广告 SDK（预防性拦截，常见于各类 App）──
# 腾讯优量汇 / 广点通
DOMAIN-SUFFIX,e.qq.com,REJECT
DOMAIN-SUFFIX,gdt.qq.com,REJECT
DOMAIN-SUFFIX,union.qq.com,REJECT
DOMAIN-SUFFIX,sdk.e.qq.com,REJECT
DOMAIN-SUFFIX,sdkreport.e.qq.com,REJECT
DOMAIN-SUFFIX,pcm.qq.com,REJECT
# 穿山甲 / 字节跳动
DOMAIN-SUFFIX,pangle.io,REJECT
DOMAIN-SUFFIX,pangolin-sdk.cn,REJECT
DOMAIN-SUFFIX,bytedance.com,REJECT
DOMAIN-SUFFIX,bytedance.net,REJECT
DOMAIN-SUFFIX,byted.org,REJECT
DOMAIN-SUFFIX,snssdk.com,REJECT
# 百度广告
DOMAIN-SUFFIX,mobads.baidu.com,REJECT
DOMAIN-SUFFIX,cpro.baidu.com,REJECT
DOMAIN-SUFFIX,pos.baidu.com,REJECT
DOMAIN-SUFFIX,cbjs.baidu.com,REJECT

[Rewrite]

[Mitm]
