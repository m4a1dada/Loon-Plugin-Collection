[Rule]
# 开屏广告 - 快手广告SDK
DOMAIN, open.kuaishouzt.com, REJECT
# 开屏广告 - Shark广告平台
DOMAIN, shark-wm.meituan.com, REJECT
# 广告平台API
DOMAIN, apimobile.meituan.com, REJECT
# 广告CDN
DOMAIN-SUFFIX, s3plus.meituan.net, REJECT
DOMAIN-SUFFIX, flowplus.meituan.net, REJECT

# 广告隧道代理IP（所有广告请求走此隧道转发）
# Loon如支持IP-CIDR则生效，不支持则无副作用
IP-CIDR, 103.37.152.97/32, REJECT, no-resolve
