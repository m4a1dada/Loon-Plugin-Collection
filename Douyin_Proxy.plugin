#!name=抖音分流
#!desc=手动切换代理/直连：抖音全域名分流，策略组「抖音分流」可切换PROXY/DIRECT
#!author=Marvis
#!tag=分流
#!system=
#!system_version=
#!loon_version=3.4.0(962)
#!homepage=https://hub.kelee.one
#!icon=https://m4a1dada.github.io/Loon-Plugin-Collection/douyin_icon.png
#!date=2026-08-12 20:05:00

[Policy]
select=抖音分流, PROXY, DIRECT

[Rule]
DOMAIN-SUFFIX, byteimg.com, 抖音分流
DOMAIN-SUFFIX, ibytedtos.com, 抖音分流
DOMAIN-SUFFIX, pstatp.com, 抖音分流
DOMAIN-SUFFIX, douyinvod.com, 抖音分流
DOMAIN-SUFFIX, amemv.com, 抖音分流
DOMAIN-SUFFIX, snssdk.com, 抖音分流
DOMAIN-SUFFIX, bytegecko.com, 抖音分流
DOMAIN-SUFFIX, douyin.com, 抖音分流
DOMAIN-SUFFIX, bytedanceapi.com, 抖音分流
DOMAIN-SUFFIX, toutiaocloud.cn, 抖音分流
DOMAIN-SUFFIX, bytecdn.com, 抖音分流
DOMAIN-SUFFIX, volces.com, 抖音分流
DOMAIN-SUFFIX, douyincdn.com, 抖音分流
DOMAIN-SUFFIX, douyinpic.com, 抖音分流
DOMAIN-SUFFIX, douyinliving.com, 抖音分流
DOMAIN-SUFFIX, douyinstatic.com, 抖音分流