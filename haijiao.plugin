[rewrite_local]
http-response ^https?:\/\/.*haijiao\.com.*\/api\/.*\/(attachment|topic)\/\d+|banner\/banner_list script-path=https://raw.githubusercontent.com/m4a1dada/Loon-Plugin-Collection@main/haijiao.js, requires-body=true, timeout=60, tag=haijiao

[mitm]
hostname = haijiao.com,*.haijiao.com
