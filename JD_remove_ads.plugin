#!name = 京东去广告
#!desc = 移除开屏广告、首页悬浮推广、物流/订单/个人页广告弹窗等。纯规则方案，无需下载脚本。
#!icon = https://raw.githubusercontent.com/Orz-3/mini/master/Color/jd.png
#!author = Marvis
#!category = 去广告
#!tag = 京东

[General]
bypass-tun = 
skip-proxy = 

[Rule]
DOMAIN-SUFFIX,jddebug.com,REJECT

[Rewrite]
# 开屏广告 - 清空图片列表
^https?:\/\/api\.m\.jd\.com\/client\.action\?functionId=start - reject-dict images,showTimesDaily
# 首页 - 移除悬浮推广层
^https?:\/\/api\.m\.jd\.com\/client\.action\?functionId=welcomeHome - reject
# 首页悬浮推广
^https?:\/\/api\.m\.jd\.com\/client\.action\?functionId=getWidgetV1052 - reject
# 首页通栏推广图
^https?:\/\/m\.360buyimg\.com\/mobilecms\/s1125x2436_jfs - reject-dict
# 新品页悬浮动图+下拉二楼
^https?:\/\/api\.m\.jd\.com\/client\.action\?functionId=getTabHomeInfo - reject-dict iconInfo,roofTop
# 物流页推广
^https?:\/\/api\.m\.jd\.com\/client\.action\?functionId=deliverLayer - reject-dict bannerInfo
^https?:\/\/api\.m\.jd\.com\/client\.action\?functionId=orderTrackBusiness - reject-dict bannerInfo
# 订单页满意度+专享权益+会员推广
^https?:\/\/api\.m\.jd\.com\/client\.action\?functionId=myOrderInfo - reject-dict floors
# 个人页弹窗+横幅+动图+推荐
^https?:\/\/api\.m\.jd\.com\/client\.action\?functionId=personinfoBusiness - reject-dict floors

[Mitm]
hostname = api.m.jd.com, m.360buyimg.com
