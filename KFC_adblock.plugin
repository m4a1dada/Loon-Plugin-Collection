#!name = 肯德基去广告
#!desc = 去除肯德基App开屏广告及内部广告（基于实际抓包分析）。纯规则方案，零脚本依赖。开屏广告倒计时为App本地硬编码逻辑，无法跳过但广告内容已屏蔽。
#!icon = https://cdn.jsdelivr.net/gh/m4a1dada/Loon-Plugin-Collection@main/icons/KFC_v3.png
#!author = m4a1dada
#!category = tool
#!tag = 去广告

[General]
bypass-tun = 
skip-proxy = 

[Rule]
# ── KFC 自有广告系统（抓包验证）──
# 开屏广告预加载 & 全量广告配置（res.kfc.com.cn 仅拦截 /CRM/kfcad/ 路径，保留 /ruleConfig/ 等非广告配置）
URL-REGEX,^https?://res\.kfc\.com\.cn/CRM/kfcad/,REJECT
# 动态广告 API 子域名
DOMAIN-SUFFIX,dynamicad.kfc.com.cn,REJECT
# 广告素材 CDN
DOMAIN-SUFFIX,sares.kfc.com.cn,REJECT
# 广告数据追踪
DOMAIN-SUFFIX,adttrackingprd.hwwt8.com,REJECT
DOMAIN-SUFFIX,trackingprd.hwwt8.com,REJECT
# AB 测试广告路由
DOMAIN-SUFFIX,abplatform.yumchina.com,REJECT
# 设备指纹（广告反作弊/追踪）
DOMAIN-SUFFIX,fp.hwwt8.com,REJECT

# ── 第三方广告 SDK 预防性规则已移除 ──
# KFC App 经抓包确认使用百胜自有广告系统，不使用腾讯/字节/百度等第三方 SDK。
# 宽泛域名（如 bytedance.com）会误伤正常 CDN 内容加载。

[Rewrite]

[Mitm]
