#!name = 微信朋友圈去广告
#!desc = 移除朋友圈信息流广告（图文广告、视频广告），纯规则方案，零脚本依赖
#!icon = https://raw.githubusercontent.com/Orz-3/mini/master/Color/WeChat.png
#!author = Marvis
#!category = 去广告
#!tag = 微信

[General]
bypass-tun = 
skip-proxy = 

[Rule]
# ── 朋友圈广告投放域名 ──
DOMAIN-SUFFIX,snsad.weixin.qq.com,REJECT
# ── 朋友圈视频广告 ──
DOMAIN-SUFFIX,snsvideo.sns.weixin.qq.com,REJECT
# ── 朋友圈广告素材 CDN ──
DOMAIN-SUFFIX,snsimg.sns.weixin.qq.com,REJECT
# ── 微信广告联盟 ──
DOMAIN-SUFFIX,wx.qlogo.cn,REJECT

[Rewrite]
# ── 朋友圈时间线广告数据清除 ──
^https?:\/\/mp\.weixin\.qq\.com\/mp\/getmasssendmsg - reject-dict

[Mitm]
hostname = mp.weixin.qq.com