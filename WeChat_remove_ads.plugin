#!name = 微信朋友圈去广告
#!desc = 移除朋友圈信息流广告（图文广告、视频广告），纯规则方案，零脚本依赖
#!icon = https://cdn.jsdelivr.net/gh/m4a1dada/Loon-Plugin-Collection@main/icons/WeChat.png
#!author = Marvis
#!category = 去广告
#!tag = 微信

[General]
bypass-tun = 
skip-proxy = 

[Rule]
# ── 微信朋友圈广告投放域 ──
DOMAIN,wxa.wxs.qq.com,REJECT
# ── 微信广告图片 CDN ──
DOMAIN,wximg.wxs.qq.com,REJECT
# ── 微信广告 ──
DOMAIN,wxsmw.wxs.qq.com,REJECT
# ── 朋友圈广告视频/图片素材 ──
DOMAIN,wxsnsdy.wxs.qq.com,REJECT
# ── 朋友圈广告缩略图 ──
DOMAIN,wxsnsdythumb.wxs.qq.com,REJECT
# ── 朋友圈广告 CDN（腾讯云） ──
DOMAIN,wxsnsdy.tc.qq.com,REJECT
# ── 朋友圈广告视频 ──
DOMAIN,wxsnsdy.video.qq.com,REJECT
# ── 微信广告桥接 ──
DOMAIN,localhost.weixin.qq.com,REJECT
DOMAIN,badjs.weixinbridge.com,REJECT
DOMAIN,cube.weixinbridge.com,REJECT

[Mitm]
hostname =